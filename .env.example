# Required
GEMINI_API_KEY=replace_me

# Models (check current Google model availability and account access)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Timing and planning
MAX_SCENE_SECONDS=4.8
MIN_SCENE_SECONDS=2.0
PLANNER_BATCH_SIZE=18

# Image generation
IMAGE_ASPECT_RATIO=16:9
IMAGE_SIZE=1K
IMAGE_RETRIES=3
IMAGE_CONCURRENCY=1

# Paths
AUDIO_PATH=assets/narration/narration.mp3
TRANSCRIPT_PATH=output/transcription/transcript.json
SCENES_PATH=output/storyboard/scenes.json
IMAGES_DIR=output/images

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
