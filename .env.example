# Gemini is used for storyboard planning and image generation.
# It is NOT used for audio transcription.
GEMINI_API_KEY=replace_me

# Local Apple Silicon Whisper transcription
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=en

# Gemini models
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Timing and planning
MAX_SCENE_SECONDS=4.8
MIN_SCENE_SECONDS=2.0
PLANNER_BATCH_SIZE=18

# Image generation
IMAGE_ASPECT_RATIO=16:9
IMAGE_SIZE=1K
IMAGE_RETRIES=3
IMAGE_CONCURRENCY=1

# Paths
AUDIO_PATH=assets/narration/narration.mp3
TRANSCRIPT_PATH=output/transcription/transcript.json
SCENES_PATH=output/storyboard/scenes.json
IMAGES_DIR=output/images

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
